#include <stdio.h>

int main() {
    int n, i;

    printf("=== STUDENT GRADING SYSTEM (switch-case version) ===\n");
    printf("Enter number of students: ");
    if (scanf("%d", &n) != 1 || n <= 0) {
        printf("Invalid number of students.\n");
        return 1;
    }

    for (i = 1; i <= n; i++) {
        char regNo[50];
        char name[50];
        float marks;
        char grade;

        printf("\n-----------------------------------\n");
        printf("Entering details for Student %d\n", i);

        printf("Enter Registration No: ");
        scanf("%s", regNo);

        printf("Enter Name: ");
        scanf("%s", name);

        printf("Enter Marks: ");
        scanf("%f", &marks);

        // Determine Grade using switch-case via integer division
        int category = (int)marks / 10;

        switch (category) {
            case 10: // For 100 marks
            case 9:  // 90-99
            case 8:  // 80-89
            case 7:  // 70-79
                grade = 'A';
                break;
            case 6:  // 60-69
                grade = 'B';
                break;
            case 5:  // 50-59
                grade = 'C';
                break;
            case 4:  // 40-49
                grade = 'D';
                break;
            default: // Below 40
                grade = 'F';
                break;
        }

        // Display Formatted Output
        printf("\n-----------------------------------\n");
        printf("        STUDENT INFORMATION        \n");
        printf("-----------------------------------\n");
        printf("Registration No: %s\n", regNo);
        printf("Name: %s\n", name);
        printf("Marks: %.2f\n", marks);
        printf("Grade: %c\n", grade);

        // Pass/Fail status using if-else
        if (marks >= 40) {
            printf("Status: Passed\n");
        } else {
            printf("Status: Failed\n");
        }
        printf("-----------------------------------\n");
    }

    return 0;
}
