
#include <stdio.h>

int main(void)
{
    int n, i;
    char regNo[50], name[50];
    float marks;
    int category;

    printf("Enter the number of students: ");

    if (scanf("%d", &n) != 1 || n <= 0)
    {
        printf("Invalid number of students.\n");
        return 1;
    }

    for (i = 1; i <= n; i++)
    {
        printf("\nSTUDENT %d\n", i);

        printf("Enter registration number: ");
        scanf("%49s", regNo);

        printf("Enter student name: ");
        scanf("%49s", name);

        printf("Enter marks: ");
        if (scanf("%f", &marks) != 1)
        {
            printf("Invalid marks entered.\n");
            return 1;
        }

        /* Validate marks */
        if (marks < 0 || marks > 100)
        {
            printf("Marks must be between 0 and 100.\n");
            continue;
        }

        category = (int)marks / 10;

        /* Determine grade */
        printf("\n--- STUDENT RESULTS ---\n");
        printf("Registration Number: %s\n", regNo);
        printf("Name: %s\n", name);
        printf("Marks: %.2f\n", marks);

        printf("Grade: ");

        switch (category)
        {
            case 10:
            case 9:
            case 8:
            case 7:
                printf("A\n");
                break;

            case 6:
                printf("B\n");
                break;

            case 5:
                printf("C\n");
                break;

            case 4:
                printf("D\n");
                break;

            default:
                printf("F\n");
                break;
        }

        /* Determine pass or fail */
        printf("Status: ");

        switch (category)
        {
            case 10:
            case 9:
            case 8:
            case 7:
            case 6:
            case 5:
            case 4:
                printf("Passed\n");
                break;

            default:
                printf("Failed\n");
                break;
        }
    }

    return 0;
}
